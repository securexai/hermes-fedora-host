# Nonsecret, unattended production template. Render through productionctl.py media.
# This file is destructive ONLY to the explicitly selected disk.
# Every secret is generated by the installer, sealed to the operator's escrow
# certificate and never written unencrypted to the target disk.
text
# Installation source: the boot media itself (inst.repo=hd:LABEL=… added by `media`),
# which is a CD-ROM in a VM but a disk on a USB stick.
lang en_US.UTF-8
keyboard us
timezone @@TIMEZONE@@ --utc
network --bootproto=dhcp --device=link --activate --hostname=@@HOSTNAME@@
selinux --enforcing
# Fedora Server enables the Cockpit web console (password login on 9090); Hermes
# needs only SSH, so the socket and its firewall service are removed.
firewall --enabled --service=ssh --remove-service=cockpit
services --enabled=sshd,chronyd --disabled=cockpit.socket
firstboot --disable
rootpw --lock
user --name=@@ADMIN@@ --groups=wheel --homedir=/home/@@ADMIN@@ --shell=/bin/bash
sshkey --username=@@ADMIN@@ "@@ADMIN_PUBLIC_KEY@@"
ignoredisk --only-use=@@DISK_ID@@
clearpart --all --initlabel --disklabel=gpt --drives=@@DISK_ID@@
bootloader --boot-drive=@@DISK_ID@@ --append="@@BOOT_APPEND@@"
part /boot/efi --fstype=efi --size=1024 --ondisk=@@DISK_ID@@
part /boot --fstype=xfs --size=2048 --ondisk=@@DISK_ID@@
# Encrypted PV with a random temporary passphrase generated in installer RAM by %pre.
# %post replaces it with an escrowed recovery key plus TPM2 PCR7, then wipes it.
%include /dev/shm/hermes-install/part.ks
volgroup hermes_system pv.hermes
logvol / --fstype=xfs --name=root --vgname=hermes_system --size=@@ROOT_MIB@@
logvol /var --fstype=xfs --name=var --vgname=hermes_system --size=@@VAR_MIB@@
logvol /home/hermes --fstype=xfs --name=hermes --vgname=hermes_system --size=@@HERMES_MIB@@
# No automatic swap: commissioning must reject unencrypted swap.

%pre --interpreter=/bin/bash --erroronfail
set -euo pipefail
python3 - <<'HERMES_ADMIN_UNUSED'
import pwd

try:
    pwd.getpwnam('@@ADMIN@@')
except KeyError:
    pass
else:
    raise SystemExit("Administrator name already exists in installer; choose a new name")
HERMES_ADMIN_UNUSED
disk='@@DISK_ID@@'
test -b "$disk"
test "$(lsblk -dn -o TYPE "$disk")" = disk
test "$(blockdev --getsize64 "$disk")" -ge $((@@DISK_MIN_MIB@@ * 1024 * 1024))
test -d /sys/firmware/efi
test -c /dev/tpmrm0
python3 - <<'HERMES_NOSAVE'
from pathlib import Path

values = [
    value.split("=", 1)[1]
    for value in Path("/proc/cmdline").read_text().split()
    if value.startswith("inst.nosave=")
]
if len(values) != 1 or values[0] not in {"all_ks", "all"}:
    raise SystemExit("Require one inst.nosave=all_ks or inst.nosave=all boot option")
HERMES_NOSAVE
python3 - <<'HERMES_REINSTALL_GUARD'
import subprocess
from pathlib import Path

labels = subprocess.run(
    ["lsblk", "-nr", "-o", "LABEL", "@@DISK_ID@@"], capture_output=True, text=True, check=True
).stdout.split()
if "hermes-production" in labels and "hermes.reinstall=yes" not in Path("/proc/cmdline").read_text().split():
    raise SystemExit("Disk already holds Hermes production; boot with hermes.reinstall=yes to replace it")
HERMES_REINSTALL_GUARD
mkdir -m 0700 /dev/shm/hermes-install
python3 - <<'HERMES_TEMPORARY_KEY'
import os
import secrets
from pathlib import Path

key = secrets.token_urlsafe(48)
rows = {
    "luks-temporary": key,
    "part.ks": "part pv.hermes --fstype=lvmpv --size=1 --grow --encrypted --luks-version=luks2 "
    "--ondisk=@@DISK_ID@@ --passphrase=%s\n" % key,
}
for name, content in rows.items():
    fd = os.open(
        Path("/dev/shm/hermes-install") / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600
    )
    with os.fdopen(fd, "w") as stream:
        stream.write(content)
HERMES_TEMPORARY_KEY
%end

%packages
@^server-product-environment
podman
container-selinux
passt
openssh-clients
openssh-server
policycoreutils
shadow-utils
sudo
dnf5
fedora-repos
fedora-gpg-keys
cryptsetup
mokutil
tpm2-tss
dracut
lvm2
tar
python3
openssl
-zram-generator-defaults
%end

%post --nochroot --interpreter=/bin/bash --erroronfail
set -euo pipefail
# Mandatory packages absent from the Server DVD and current signed updates (Podman
# >= 5.8.4). shim stays at the installer's version: a newer shim can apply a new
# SbatLevel on first boot, changing PCR7 from the value enrolled during %post.
# Preserve the target's resolver symlink for the installer chroot.
mkdir -p -m 0755 /mnt/sysroot/run/systemd/resolve
if ! [ /etc/resolv.conf -ef /mnt/sysroot/run/systemd/resolve/stub-resolv.conf ]; then
  cp /etc/resolv.conf /mnt/sysroot/run/systemd/resolve/stub-resolv.conf
  chmod 0644 /mnt/sysroot/run/systemd/resolve/stub-resolv.conf
fi
# Installed Fedora signing keys only; any failure stops the installation. The
# installer image lacks coreutils install/timeout, so timeout runs in the target.
chroot /mnt/sysroot timeout --signal=TERM --kill-after=10s 1800s \
  dnf5 --releasever=44 --disable-repo='*' --enable-repo=fedora --enable-repo=updates \
  --setopt=fedora.gpgcheck=1 --setopt=updates.gpgcheck=1 --assumeyes upgrade \
  --exclude='shim-*'
chroot /mnt/sysroot timeout --signal=TERM --kill-after=10s 600s \
  dnf5 --releasever=44 --disable-repo='*' --enable-repo=fedora --enable-repo=updates \
  --setopt=fedora.gpgcheck=1 --setopt=updates.gpgcheck=1 --assumeyes install restic tpm2-tools
chroot /mnt/sysroot rpm -q restic tpm2-tools
%end

%post --nochroot --interpreter=/bin/bash --erroronfail
set -euo pipefail
# Private tmpfs inside the target: chroot-visible, never written to the disk.
mkdir -m 0700 /mnt/sysroot/var/lib/hermes-install
mount -t tmpfs -o mode=0700,size=64m,nosuid,nodev,noexec tmpfs /mnt/sysroot/var/lib/hermes-install
(umask 077 && cp /dev/shm/hermes-install/luks-temporary /mnt/sysroot/var/lib/hermes-install/luks-temporary)
# Copy only the hash-pinned public controller payload from the install media.
python3 - <<'HERMES_CONTROLLER_COPY'
import hashlib
import json
import os
from pathlib import Path

PINNED = "@@MANIFEST_SHA256@@"
found = set()
for root in [Path("/run/install/repo"), *Path("/run/install").glob("sources/*"), Path("/run/install/isodir")]:
    candidate = root / "hermes-installer" / "manifest.json"
    try:
        if hashlib.sha256(candidate.read_bytes()).hexdigest() == PINNED:
            found.add(candidate.parent.resolve())
    except OSError:
        pass
# dracut and Anaconda may mount the same media twice; every candidate already
# matches the pinned manifest hash and each file is re-hashed below.
if not found:
    raise SystemExit("Pinned Hermes installer payload not found on the install media")
source = sorted(found)[0]
files = json.loads((source / "manifest.json").read_bytes())["files"]
target = Path("/mnt/sysroot/usr/local/libexec/hermes-installer")
os.makedirs(target / "production", mode=0o755)
for name, digest in sorted(files.items()):
    if name.startswith("/") or ".." in Path(name).parts:
        raise SystemExit("Unsafe installer payload path")
    data = (source / name).read_bytes()
    if hashlib.sha256(data).hexdigest() != digest:
        raise SystemExit("Installer payload hash mismatch")
    mode = 0o755 if name in ("productionctl.py", "production-launcher.py") else 0o644
    fd = os.open(target / name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    with os.fdopen(fd, "wb") as stream:
        stream.write(data)
    os.chmod(target / name, mode)
(target / "manifest.json").write_bytes((source / "manifest.json").read_bytes())
for path in [target, target / "production"]:
    os.chmod(path, 0o755)
HERMES_CONTROLLER_COPY
%end

%post --interpreter=/bin/bash --erroronfail
set -euo pipefail
python3 - <<'HERMES_ADMIN_VERIFY'
import grp
import os
import pwd
import stat
import subprocess
from pathlib import Path

def require(condition):
    if not condition:
        raise SystemExit("Installed administrator identity or SSH-key validation failed")

name = '@@ADMIN@@'
account = pwd.getpwnam(name)
require(1000 <= account.pw_uid <= 60000 and 1000 <= account.pw_gid <= 60000)
require(account.pw_dir == '/home/' + name and account.pw_shell == '/bin/bash')
require(grp.getgrnam('wheel').gr_gid in os.getgrouplist(name, account.pw_gid))
home = Path(account.pw_dir)
parent = home.parent.lstat()
require(stat.S_ISDIR(parent.st_mode) and parent.st_uid == 0 and not parent.st_mode & 0o022)
paths = (home, home / '.ssh', home / '.ssh/authorized_keys')
for path in paths:
    info = path.lstat()
    require(info.st_uid == account.pw_uid and info.st_gid == account.pw_gid)
    require(not info.st_mode & 0o022)
    if path == paths[-1]:
        require(stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode) == 0o600)
    else:
        require(stat.S_ISDIR(info.st_mode))
        if path == paths[1]:
            require(stat.S_IMODE(info.st_mode) == 0o700)
require(paths[-1].read_text().strip() == '@@ADMIN_PUBLIC_KEY@@')
for path in paths:
    result = subprocess.run(
        ['matchpathcon', '-V', str(path)], capture_output=True, check=False
    )
    require(result.returncode == 0)
HERMES_ADMIN_VERIFY
# Recovery key + TPM2 PCR7 enrollment, temporary-slot wipe, escrowed admin
# password, header backup and the one-shot commissioning unit.
python3 -I -B /usr/local/libexec/hermes-installer/productionctl.py install-commission
%end

%post --nochroot --interpreter=/bin/bash --erroronfail
set -euo pipefail
umount /mnt/sysroot/var/lib/hermes-install
rmdir /mnt/sysroot/var/lib/hermes-install
rm -f /dev/shm/hermes-install/luks-temporary /dev/shm/hermes-install/part.ks
%end

# Unattended: firstboot finishes commissioning. %pre refuses to reinstall over an
# existing Hermes disk, so a boot-order mistake cannot repeat the installation.
reboot --eject
