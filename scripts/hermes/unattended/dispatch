#!/usr/bin/bash -p
# Install this wrapper and its Python modules root-owned under /usr/local/libexec.
set -euo pipefail
[[ $# == 0 ]] || exit 64
exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 HOME=/root /usr/bin/timeout --signal=TERM --kill-after=10s 30m /usr/bin/python3 -E -s /usr/local/libexec/hermes-unattended/dispatcher.py
