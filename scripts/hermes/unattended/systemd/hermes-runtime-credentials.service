[Unit]
Description=Hermes volatile provider credential file
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=true
LoadCredentialEncrypted=openai-api:/etc/credstore.encrypted/hermes-openai-api
ExecStart=/usr/bin/python3 -I /usr/local/libexec/hermes-unattended/materialize.py
UMask=0077
LimitCORE=0
StandardOutput=null
StandardError=null
