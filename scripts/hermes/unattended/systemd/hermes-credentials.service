[Unit]
Description=Hermes isolated provider credential administration
Requires=hermes-credentials.socket
After=network-online.target
Wants=network-online.target

[Service]
User=hermes-credentials
Group=hermes-credentials
ExecStart=/usr/bin/python3 -E -s /usr/local/libexec/hermes-unattended/credentials.py
LoadCredentialEncrypted=openai-admin:/etc/credstore.encrypted/hermes-openai-admin
StateDirectory=hermes-credentials
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
LimitCORE=0
StandardOutput=null
StandardError=null
