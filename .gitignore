# Secrets and machine-local agent state — never commit.
.mcp.json
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# uv / build output
dist/
build/

# Local correction review logs; retained on disk outside the migration payload.
.hermes-correction-evidence/

# Toolbox and container scratch
.toolbox/
*.qcow2

# Project-declared tool extensions (installed by toolbox/install-extensions.sh)
toolbox/.tools/

# Editor and OS noise
.DS_Store
*.swp

# ShellSpec fixture scratch: the "no remote contact" marker is written at run
# time by spec/hermes/fixtures/ssh and must never be committed.
spec/hermes/fixtures/*.called
